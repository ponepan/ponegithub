{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/fc-api/:path*",
      "destination": "/api/fc-proxy/:path*"
    },
    {
      "source": "/tc-api/:path*",
      "destination": "/api/tc-proxy/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
